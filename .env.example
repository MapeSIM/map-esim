# VeSIM broker (server-only — never expose to the client)
# Mode must match VESIM_BASE_URL. Missing/invalid values block provider orders.
# Allowed: staging | live  (no automatic fallback to live)
VESIM_ENVIRONMENT=staging
# Confirmed staging broker: https://www.vesim.xyz  (hosts: www.vesim.xyz, vesim.xyz)
# Live broker/API host is not confirmed yet — VESIM_ENVIRONMENT=live fails closed.
VESIM_BASE_URL=
VESIM_EMAIL=
VESIM_PASSWORD=

# Public guest VeSIM checkout (POST /api/vesim/checkout) — server-only.
# Exactly "true" enables real provider orders from the guest checkout UI.
# Missing or any other value = disabled (fail closed). Keep false in production
# until payment integration, durable idempotency, and rate limiting are complete.
ENABLE_GUEST_VESIM_CHECKOUT=false


# Public site origin used in customer emails (Android guide links, etc.)
APP_BASE_URL=https://mapesim.com

# Tawk.to live chat (optional — public widget IDs only; leave empty to disable)
# Dashboard: Administration → Channels → Chat Widget → Direct Chat Link
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# Cryptographically strong secret for signed order-access tokens (32+ chars).
# If unset, a server-only fallback is derived from VeSIM credentials.
ORDER_ACCESS_SECRET=

# ICCID at-rest encryption (server-only). Required to persist ICCIDs.
# 64-char hex (32 bytes) or base64/base64url encoding of exactly 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never use NEXT_PUBLIC_*. Never commit a real key.
ICCID_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Transactional email (Hostinger SMTP) — server-only
# Put real passwords only in .env.local / deployment secrets (never commit).
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
# 465 = implicit TLS (SMTP_SECURE=true). 587 = STARTTLS (do not disable encryption).
SMTP_PORT=465
SMTP_SECURE=true

# SECURITY channel — OTP, password-changed, account security notices
SMTP_SECURITY_USER=security@mapesim.com
SMTP_SECURITY_PASSWORD=

# ORDERS channel — order confirmation, QR / install details, resend
SMTP_ORDERS_USER=orders@mapesim.com
SMTP_ORDERS_PASSWORD=

# BILLING channel — receipts, payment/refund notices, invoices
SMTP_BILLING_USER=billing@mapesim.com
SMTP_BILLING_PASSWORD=

# SUPPORT channel — support/contact and assistance mail
SMTP_SUPPORT_USER=support@mapesim.com
SMTP_SUPPORT_PASSWORD=

# Default Reply-To for SECURITY / ORDERS / BILLING (display: MAP eSIM Support)
EMAIL_REPLY_TO=support@mapesim.com

# Controlled recipient for `npm run email:test -- <channel>` (single address only)
EMAIL_TEST_RECIPIENT=

# Comma-separated allowlist for Monitoring alert notification emails (server-only).
# Trimmed, deduplicated, capped; missing/invalid fails closed (no admin fallback).
ALERT_NOTIFICATION_RECIPIENTS=

# PostgreSQL connection for Prisma (required for accounts / guest order persistence)
DATABASE_URL=

# Auth.js (required for sign-in sessions — 32+ character secret)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (optional — leave empty to hide/disable Google sign-in)
# Local callback:  http://localhost:3000/api/auth/callback/google
# Production:      https://mapesim.com/api/auth/callback/google
# Put real values only in .env.local / deployment secrets — never commit them.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# One-time admin bootstrap via `npm run admin:seed` (server terminal only).
# Put real values only in .env.local / deployment secrets — never commit them.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
