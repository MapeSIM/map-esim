# VeSIM broker (server-only — never expose to the client)
VESIM_BASE_URL=
VESIM_EMAIL=
VESIM_PASSWORD=

# Public site origin used in customer emails (Android guide links, etc.)
APP_BASE_URL=https://mapesim.com

# Cryptographically strong secret for signed order-access tokens (32+ chars).
# If unset, a server-only fallback is derived from VeSIM credentials.
ORDER_ACCESS_SECRET=

# ---------------------------------------------------------------------------
# Transactional email (Hostinger SMTP) — server-only
# Put real passwords only in .env.local / deployment secrets (never commit).
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
# 465 = implicit TLS (SMTP_SECURE=true). 587 = STARTTLS (do not disable encryption).
SMTP_PORT=465
SMTP_SECURE=true

# SECURITY channel — OTP, password-changed, account security notices
SMTP_SECURITY_USER=security@mapesim.com
SMTP_SECURITY_PASSWORD=

# ORDERS channel — order confirmation, QR / install details, resend
SMTP_ORDERS_USER=orders@mapesim.com
SMTP_ORDERS_PASSWORD=

# BILLING channel — receipts, payment/refund notices, invoices
SMTP_BILLING_USER=billing@mapesim.com
SMTP_BILLING_PASSWORD=

# SUPPORT channel — support/contact and assistance mail
SMTP_SUPPORT_USER=support@mapesim.com
SMTP_SUPPORT_PASSWORD=

# Default Reply-To for SECURITY / ORDERS / BILLING (display: MAP eSIM Support)
EMAIL_REPLY_TO=support@mapesim.com

# Controlled recipient for `npm run email:test -- <channel>` (single address only)
EMAIL_TEST_RECIPIENT=

# PostgreSQL connection for Prisma (required for accounts / guest order persistence)
DATABASE_URL=

# Auth.js (required for sign-in sessions — 32+ character secret)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# One-time admin bootstrap via `npm run admin:seed` (server terminal only).
# Put real values only in .env.local / deployment secrets — never commit them.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
