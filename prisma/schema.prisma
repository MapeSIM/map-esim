generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderClaimStatus {
  UNCLAIMED
  CLAIMED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_DELETION
}

enum WalletCurrency {
  USD
}

enum WalletDirection {
  CREDIT
  DEBIT
}

enum WalletTransactionType {
  ADMIN_CREDIT
  TOPUP_CREDIT
  PURCHASE_DEBIT
  REFUND_CREDIT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
  REVERSAL
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model User {
  id                     String               @id @default(cuid())
  name                   String
  email                  String               @unique
  /// Null for future OAuth-only accounts (no local password yet).
  passwordHash           String?
  /// Optional avatar URL (e.g. from an OAuth profile). Unused by Credentials.
  image                  String?
  role                   Role                 @default(CUSTOMER)
  emailVerifiedAt        DateTime?
  /// JWT sessions issued before this timestamp are rejected after password reset.
  credentialsChangedAt   DateTime?
  /// Soft-delete timestamp. When set, the account cannot sign in.
  deletedAt              DateTime?
  /// Incremented on each ADMIN credentials sign-in; JWT must match (single active admin session).
  adminSessionVersion    Int                  @default(0)
  /// Signup (or future) consent to Terms & Conditions.
  termsAcceptedAt        DateTime?
  termsVersion           String?
  /// Signup (or future) acknowledgement of Privacy Policy.
  privacyAcknowledgedAt  DateTime?
  privacyVersion         String?
  /// Where consent was captured (e.g. "signup"). Null for legacy users.
  legalConsentSource     String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  accounts               Account[]
  sessions               Session[]
  orders                 Order[]
  passwordResetTokens    PasswordResetToken[]
  emailOtps              EmailOtp[]
  auditLogs              AuditLog[]           @relation("AuditActor")
  walletAccount          WalletAccount?

  @@index([deletedAt])
}

model EmailOtp {
  id         String     @id @default(cuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int        @default(0)
  lastSentAt DateTime   @default(now())
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Order {
  id               String           @id @default(cuid())
  providerOrderId  String           @unique
  userId           String?
  customerEmail    String
  offerId          String
  destination      String?
  planName         String?
  dataAllowance    String?
  validity         String?
  providerAmount   Decimal?         @db.Decimal(12, 2)
  providerCurrency String?          @default("USD")
  displayAmount    Decimal?         @db.Decimal(12, 2)
  displayCurrency  String?
  status           OrderStatus      @default(COMPLETED)
  iccidEncrypted   String?
  claimStatus      OrderClaimStatus @default(UNCLAIMED)
  claimedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerEmail])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

/// Customer USD wallet account. One per user. Balance is integer cents only.
model WalletAccount {
  id           String         @id @default(cuid())
  userId       String         @unique
  currency     WalletCurrency @default(USD)
  balanceCents Int            @default(0)
  version      Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([createdAt])
}

/// Append-only wallet ledger entry (writes arrive in later phases).
model WalletTransaction {
  id                String                  @id @default(cuid())
  walletId          String
  type              WalletTransactionType
  direction         WalletDirection
  status            WalletTransactionStatus
  amountCents       Int
  balanceAfterCents Int?
  idempotencyKey    String?                 @unique
  referenceType     String?
  referenceId       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  wallet            WalletAccount           @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@index([type])
  @@index([status])
  @@index([walletId, createdAt])
}
