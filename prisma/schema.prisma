generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  PARTNER
}

enum PartnerWalletTransactionType {
  ADMIN_CREDIT
  ADMIN_DEBIT
  /// Automated Partner eSIM purchase debit (never reuse ADMIN_DEBIT).
  ESIM_PURCHASE_DEBIT
  /// Automated confirmed-failure / restore refund of a Partner eSIM purchase debit.
  ESIM_PURCHASE_REFUND
}

enum OrderClaimStatus {
  UNCLAIMED
  CLAIMED
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
}

enum OrderFundingSource {
  COMPANY_FUNDED
  CUSTOMER_WALLET
  /// Customer package funded by wallet contribution + gateway remainder.
  CUSTOMER_SPLIT
  DIRECT_PAYMENT
  /// Partner prepaid wallet (PartnerWalletAccount) — never Customer WalletAccount.
  PARTNER_BALANCE
}

enum AdminPackageAssignmentStatus {
  DRAFT
  READY
  PROVIDER_PENDING
  COMPLETED
  FAILED
  RECONCILIATION_REQUIRED
}

enum WalletEsimPurchaseStatus {
  DRAFT
  READY
  /// Waiting for verified gateway payment of gatewayAmountCents (future split path).
  AWAITING_GATEWAY_PAYMENT
  FUNDS_RESERVED
  /// Funding fully secured (wallet reserved + gateway confirmed when required).
  FUNDED
  PROVIDER_PENDING
  COMPLETED
  FAILED_REFUNDED
  RECONCILIATION_REQUIRED
}

/// Durable Partner wallet-funded eSIM purchase attempt (provider write outside Prisma tx).
/// Mirrors WalletEsimPurchase terminology for equivalent states; no gateway split path.
enum PartnerEsimPurchaseStatus {
  DRAFT
  READY
  FUNDS_RESERVED
  PROVIDER_PENDING
  COMPLETED
  FAILED_REFUNDED
  RECONCILIATION_REQUIRED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_DELETION
}

enum PromoDiscountType {
  PERCENT
  FIXED_USD
}

enum PromoRedemptionStatus {
  HELD
  COMPLETED
  RELEASED
}

enum CustomerRewardRedemptionStatus {
  HELD
  COMPLETED
  RELEASED
}

enum CustomerRewardTransactionType {
  PURCHASE_EARN
  PURCHASE_EARN_REVERSAL
  REDEMPTION
  REDEMPTION_RESTORE
  ADMIN_ADJUSTMENT
}

enum WalletCurrency {
  USD
}

enum WalletDirection {
  CREDIT
  DEBIT
}

enum WalletTransactionType {
  ADMIN_CREDIT
  TOPUP_CREDIT
  PURCHASE_DEBIT
  REFUND_CREDIT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
  REVERSAL
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WalletTopupStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  CREDITED
  FAILED
  EXPIRED
  CANCELLED
  RECONCILIATION_REQUIRED
}

/// Gateway payment attempt for an eSIM purchase remainder (not wallet top-up).
enum EsimPurchasePaymentAttemptStatus {
  DRAFT
  AWAITING_PAYMENT
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  RECONCILIATION_REQUIRED
}

/// Gateway providers for future Pakistan market adapters. None are active in Phase 6A.
enum PaymentGatewayProvider {
  SIMPAISA
  PAYFAST
  SAFEPAY
  JAZZCASH
  EASYPAISA
  MANUAL_TEST
}

/// Customer refund request workflow (review only — no money movement in this phase).
enum RefundRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED_PENDING_EXECUTION
  REJECTED
  COMPLETED
  CANCELLED
}

enum RefundRequestReason {
  TECHNICAL_ISSUE
  DUPLICATE_PAYMENT
  ESIM_NOT_RECEIVED
  WRONG_PLAN
  UNUSED_PLAN
  OTHER
}

/// Partner-initiated refund request reasons (separate from customer RefundRequestReason).
enum PartnerRefundRequestReason {
  ESIM_NOT_RECEIVED
  INSTALL_DETAILS_UNAVAILABLE
  PROVIDER_OR_ORDER_ISSUE
  OTHER
}

/// Allowlisted runtime pause switches only (Admin Operations Part A2).
/// Never stores secrets, arbitrary JSON, or customer data.
enum OperationalControlKey {
  TRANSACTION_MAINTENANCE
  CUSTOMER_WALLET_PURCHASES
  ADMIN_WALLET_PURCHASES
  COMPANY_ASSIGNMENTS
  PROVIDER_ORDER_CREATION
  /// Pauses new Partner wallet-funded eSIM purchases (enforcement in later Phase 2 slices).
  PARTNER_WALLET_PURCHASES
  /// Pauses alert-notification email delivery only. Aggregation/dashboard stay live.
  ALERT_NOTIFICATIONS
}

enum AlertNotificationEventType {
  INITIAL
  REMINDER
  RECOVERY
}

enum AlertNotificationDeliveryStatus {
  PENDING
  CLAIMED
  SENT
  FAILED
}

model User {
  id                           String                   @id @default(cuid())
  name                         String
  email                        String                   @unique
  /// Null for future OAuth-only accounts (no local password yet).
  passwordHash                 String?
  /// Optional avatar URL (e.g. from an OAuth profile). Unused by Credentials.
  image                        String?
  role                         Role                     @default(CUSTOMER)
  emailVerifiedAt              DateTime?
  /// JWT sessions issued before this timestamp are rejected after password reset.
  credentialsChangedAt         DateTime?
  /// Soft-delete timestamp. When set, the account cannot sign in.
  deletedAt                    DateTime?
  /// Admin block (Model 2): null = not blocked. Does not revoke sessions or deny login.
  blockedAt                    DateTime?
  /// Internal admin-only reason. Never expose to the customer.
  blockedReason                String?
  blockedByAdminId             String?
  /// CAS version for block/reactivate admin actions.
  accountStatusVersion         Int                      @default(0)
  /// Incremented on each ADMIN credentials sign-in; JWT must match (single active admin session).
  adminSessionVersion          Int                      @default(0)
  /// Admin disable (Admin Users): null = not disabled. Denies admin login/access when set.
  adminDisabledAt              DateTime?
  /// CAS version for admin deactivate/reactivate.
  adminStatusVersion           Int                      @default(0)
  /// Signup (or future) consent to Terms & Conditions.
  termsAcceptedAt              DateTime?
  termsVersion                 String?
  /// Signup (or future) acknowledgement of Privacy Policy.
  privacyAcknowledgedAt        DateTime?
  privacyVersion               String?
  /// Where consent was captured (e.g. "signup"). Null for legacy users.
  legalConsentSource           String?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  accounts                     Account[]
  sessions                     Session[]
  orders                       Order[]
  passwordResetTokens          PasswordResetToken[]
  partnerInviteTokens          PartnerInviteToken[]
  partnerInviteSetupTokens     PartnerInviteSetupToken[]
  adminInviteSetupTokens       AdminInviteSetupToken[]
  emailOtps                    EmailOtp[]
  auditLogs                    AuditLog[]               @relation("AuditActor")
  blockedByAdmin               User?                    @relation("UserBlockedByAdmin", fields: [blockedByAdminId], references: [id], onDelete: SetNull)
  customersBlocked             User[]                   @relation("UserBlockedByAdmin")
  walletAccount                WalletAccount?
  packageAssignmentsAsCustomer AdminPackageAssignment[] @relation("AssignmentCustomer")
  packageAssignmentsAsAdmin    AdminPackageAssignment[] @relation("AssignmentAdmin")
  walletEsimPurchases          WalletEsimPurchase[]     @relation("WalletPurchaseCustomer")
  assistedWalletEsimPurchases  WalletEsimPurchase[]     @relation("AssistedWalletPurchaseAdmin")
  walletTopups                 WalletTopup[]
  refundRequests               RefundRequest[]          @relation("RefundRequestCustomer")
  refundRequestsReviewed       RefundRequest[]          @relation("RefundRequestReviewedBy")
  refundRequestsDecided        RefundRequest[]          @relation("RefundRequestDecidedBy")
  partnerProfile               PartnerProfile?
  partnerWalletTxCreated       PartnerWalletTransaction[] @relation("PartnerWalletTxCreatedByAdmin")
  promoCodesCreated            PromoCode[]                @relation("PromoCodeCreatedByAdmin")
  promoCodeRedemptions         PromoCodeRedemption[]
  customerRewardAccount        CustomerRewardAccount?     @relation("CustomerRewardAccount")
  customerRewardTransactions   CustomerRewardTransaction[] @relation("CustomerRewardTransaction")
  customerRewardRedemptions    CustomerRewardRedemption[] @relation("CustomerRewardRedemption")

  @@index([deletedAt])
  @@index([blockedAt])
  @@index([adminDisabledAt])
}

/// 1:1 Partner/reseller profile for Role.PARTNER users.
model PartnerProfile {
  id              String               @id @default(cuid())
  userId          String               @unique
  /// Discount in basis points (500 = 5.00%). Applied at future purchase debit time.
  discountBps     Int                  @default(0)
  /// CAS version for discount changes (purchase confirm will use in Phase 2).
  discountVersion Int                  @default(0)
  /// Null = active. When set, Partner portal + financial actions are denied.
  disabledAt      DateTime?
  /// CAS version for disable/reactivate.
  statusVersion   Int                  @default(0)
  /// Optional Partner share-page branding (Phase 3 Slice 3). Null = MAP eSIM fallback.
  shareCompanyName        String?
  shareSupportEmail       String?
  shareWebsiteUrl         String?
  shareLogoUrl            String?
  shareButtonBackground   String?
  shareButtonTextColor    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAccount   PartnerWalletAccount?
  esimPurchases   PartnerEsimPurchase[]
  esimShareTokens PartnerEsimShareToken[]
  refundRequests  PartnerRefundRequest[]

  @@index([disabledAt])
  @@index([createdAt])
}

/// Separate Partner prepaid balance (integer USD cents). Not customer WalletAccount.
model PartnerWalletAccount {
  id           String                     @id @default(cuid())
  partnerId    String                     @unique
  currency     WalletCurrency             @default(USD)
  balanceCents Int                        @default(0)
  version      Int                        @default(0)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  partner      PartnerProfile             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  transactions PartnerWalletTransaction[]

  @@index([createdAt])
}

/// Append-only Partner wallet ledger (Phase 1: admin credit/debit only).
model PartnerWalletTransaction {
  id                     String                        @id @default(cuid())
  partnerWalletAccountId String
  type                   PartnerWalletTransactionType
  amountCents            Int
  balanceBeforeCents     Int
  balanceAfterCents      Int
  reason                 String
  referenceType          String?
  referenceId            String?
  createdByAdminId       String?
  idempotencyKey         String?                       @unique
  createdAt              DateTime                      @default(now())
  wallet                 PartnerWalletAccount          @relation(fields: [partnerWalletAccountId], references: [id], onDelete: Cascade)
  createdByAdmin         User?                         @relation("PartnerWalletTxCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  purchaseAsDebit        PartnerEsimPurchase?          @relation("PartnerPurchaseDebitTx")
  purchaseAsRefund       PartnerEsimPurchase?          @relation("PartnerPurchaseRefundTx")

  @@index([partnerWalletAccountId, createdAt])
  @@index([createdByAdminId])
  @@index([createdAt])
}

model EmailOtp {
  id         String     @id @default(cuid())
  userId     String
  purpose    OtpPurpose
  codeHash   String
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int        @default(0)
  lastSentAt DateTime   @default(now())
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

/// Opaque Partner invitation token (email link). Store hash only; never log raw token.
model PartnerInviteToken {
  id         String                    @id @default(cuid())
  userId     String
  tokenHash  String                    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                  @default(now())
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  setupTokens PartnerInviteSetupToken[]

  @@index([userId])
  @@index([expiresAt])
}

/// Short-lived setup-session cookie after invite URL exchange (keeps raw invite token out of the URL).
model PartnerInviteSetupToken {
  id         String             @id @default(cuid())
  userId     String
  inviteId   String
  tokenHash  String             @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invite     PartnerInviteToken @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([inviteId])
  @@index([expiresAt])
}

/// Opaque Admin invitation password-setup token (email link). Store hash only; never log raw token.
model AdminInviteSetupToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Order {
  id                               String                  @id @default(cuid())
  providerOrderId                  String                  @unique
  userId                           String?
  customerEmail                    String
  offerId                          String
  destination                      String?
  planName                         String?
  dataAllowance                    String?
  validity                         String?
  providerAmount                   Decimal?                @db.Decimal(12, 2)
  providerCurrency                 String?                 @default("USD")
  displayAmount                    Decimal?                @db.Decimal(12, 2)
  displayCurrency                  String?
  /// Frozen customer-confirmed alternate MAP install-email recipient. Null = use customerEmail.
  /// Confirmation is customer attestation only — not ownership verification. Not indexed.
  alternateDeliveryEmail           String?
  /// Null for legacy guest checkout orders.
  fundingSource                    OrderFundingSource?
  status                           OrderStatus             @default(COMPLETED)
  /// AES-256-GCM ciphertext (never plaintext). Null until captured.
  iccidEncrypted                   String?
  /// Deterministic HMAC for duplicate detection (not reversible).
  iccidHash                        String?
  /// Last four digits only — safe for masked admin list/detail display.
  iccidLast4                       String?
  iccidCapturedAt                  DateTime?
  claimStatus                      OrderClaimStatus        @default(UNCLAIMED)
  claimedAt                        DateTime?
  /// Case-management only — never stores ICCID plaintext or provider secrets.
  reconciliationResolvedAt         DateTime?
  reconciliationResolvedByAdminId  String?
  reconciliationResolutionReason   String?
  reconciliationResolutionCode     String?
  reconciliationLockedAt           DateTime?
  reconciliationLockedByAdminId    String?
  reconciliationLockReason         String?
  reconciliationEscalatedAt        DateTime?
  reconciliationEscalatedByAdminId String?
  reconciliationEscalationReason   String?
  reconciliationEscalationPriority String?
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt
  user                             User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  adminPackageAssignment           AdminPackageAssignment?
  walletEsimPurchase               WalletEsimPurchase?
  partnerEsimPurchase              PartnerEsimPurchase?
  partnerEsimShareTokens           PartnerEsimShareToken[]
  refundRequests                   RefundRequest[]
  partnerRefundRequests            PartnerRefundRequest[]
  promoRedemptions                 PromoCodeRedemption[]
  customerRewardTransactions       CustomerRewardTransaction[]

  @@index([customerEmail])
  @@index([userId])
  @@index([fundingSource])
  /// Non-unique until backfill completes; app enforces one-hash-per-order.
  @@index([iccidHash])
  @@index([reconciliationResolvedAt])
  @@index([reconciliationLockedAt])
  @@index([reconciliationEscalatedAt])
}

/// Durable ADMIN company-funded eSIM assignment attempt (provider write outside Prisma tx).
model AdminPackageAssignment {
  id                               String                       @id @default(cuid())
  customerUserId                   String
  adminUserId                      String
  offerId                          String
  destinationCode                  String?
  destinationName                  String?
  planName                         String?
  dataAllowance                    String?
  validity                         String?
  fundingSource                    OrderFundingSource           @default(COMPANY_FUNDED)
  /// Provider/company cost snapshot in integer USD cents when reliably available.
  providerCostCents                Int?
  providerCurrency                 String                       @default("USD")
  status                           AdminPackageAssignmentStatus @default(DRAFT)
  idempotencyKey                   String                       @unique
  orderId                          String?                      @unique
  /// Stored only when required for reconciliation; never shown to CUSTOMER.
  providerOrderId                  String?
  /// Safe provider outcome snapshot: success | declined | uncertain | none
  providerResultKind               String?
  providerObservedAt               DateTime?
  /// Non-secret provider status token (e.g. http_500). Never raw payload.
  safeProviderStatusCode           String?
  reconciliationResolvedAt         DateTime?
  reconciliationResolvedByAdminId  String?
  reconciliationResolutionReason   String?
  reconciliationResolutionCode     String?
  reconciliationLockedAt           DateTime?
  reconciliationLockedByAdminId    String?
  reconciliationLockReason         String?
  reconciliationEscalatedAt        DateTime?
  reconciliationEscalatedByAdminId String?
  reconciliationEscalationReason   String?
  reconciliationEscalationPriority String?
  /// Durable provider-status refresh claim (single-flight). Null when idle.
  providerRefreshClaimedAt         DateTime?
  providerRefreshCompletedAt       DateTime?
  providerRefreshByAdminId         String?
  /// Sanitized lookup result: FOUND | NOT_FOUND | UNKNOWN | TIMEOUT | …
  providerRefreshResult            String?
  providerRefreshSafeCode          String?
  /// yes | no | unknown
  providerRefreshOrderExists       String?
  providerRefreshOfferMatch        String?
  providerRefreshInstallData       String?
  /// Short non-secret provider state token only.
  providerRefreshSafeState         String?
  reason                           String
  internalReference                String?
  failureCategory                  String?
  failureCode                      String?
  reconciliationState              String?
  emailDeliveryStatus              String?
  createdAt                        DateTime                     @default(now())
  updatedAt                        DateTime                     @updatedAt
  completedAt                      DateTime?
  customer                         User                         @relation("AssignmentCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  admin                            User                         @relation("AssignmentAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)
  order                            Order?                       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerUserId])
  @@index([adminUserId])
  @@index([status])
  @@index([createdAt])
  @@index([customerUserId, createdAt])
  @@index([providerOrderId])
  @@index([providerResultKind])
  @@index([status, updatedAt])
  @@index([reconciliationResolvedAt])
  @@index([reconciliationLockedAt])
  @@index([reconciliationEscalatedAt])
  @@index([providerRefreshClaimedAt])
  @@index([providerRefreshResult])
}

/// Durable CUSTOMER wallet-funded eSIM purchase attempt (provider write outside Prisma tx).
model WalletEsimPurchase {
  id                               String                   @id @default(cuid())
  customerUserId                   String
  /// Null for self-service CUSTOMER purchases. Set for admin-assisted wallet buys.
  adminUserId                      String?
  /// Required when adminUserId is set. Never shown to CUSTOMER.
  assistedPurchaseReason           String?
  offerId                          String
  destinationCode                  String?
  destinationName                  String?
  planName                         String?
  dataAllowance                    String?
  validity                         String?
  /// Authoritative customer selling price in integer USD cents.
  priceCents                       Int
  /// Optional customer promo applied at checkout. priceCents stays the catalog price.
  promoCodeId                      String?
  promoCodeNormalized              String?
  promoDiscountCents               Int                      @default(0)
  /// Customer chose to apply wallet funds (server-persisted; never trust browser money).
  useWallet                        Boolean                  @default(true)
  /// Customer chose to apply rewards at checkout. Server recomputes points; never trust browser money.
  useRewards                       Boolean                  @default(false)
  /// Snapshotted reward points applied (1 point = 1 USD cent). Preview until held/completed.
  rewardPointsRedeemed             Int                      @default(0)
  /// Server-calculated wallet contribution in USD cents.
  walletAppliedCents               Int
  /// Server-calculated gateway remainder in USD cents.
  gatewayAmountCents               Int                      @default(0)
  /// Provider/partner cost snapshot when safely available (ADMIN-only visibility).
  providerCostCents                Int?
  currency                         String                   @default("USD")
  fundingSource                    OrderFundingSource       @default(CUSTOMER_WALLET)
  status                           WalletEsimPurchaseStatus @default(DRAFT)
  idempotencyKey                   String                   @unique
  debitTransactionId               String?                  @unique
  refundTransactionId              String?                  @unique
  orderId                          String?                  @unique
  /// Stored only when required for reconciliation; never shown to CUSTOMER.
  providerOrderId                  String?
  /// Safe provider outcome snapshot: success | declined | uncertain | none
  providerResultKind               String?
  providerObservedAt               DateTime?
  /// Non-secret provider status token (e.g. http_500). Never raw payload.
  safeProviderStatusCode           String?
  reconciliationResolvedAt         DateTime?
  reconciliationResolvedByAdminId  String?
  reconciliationResolutionReason   String?
  reconciliationResolutionCode     String?
  reconciliationLockedAt           DateTime?
  reconciliationLockedByAdminId    String?
  reconciliationLockReason         String?
  reconciliationEscalatedAt        DateTime?
  reconciliationEscalatedByAdminId String?
  reconciliationEscalationReason   String?
  reconciliationEscalationPriority String?
  /// Durable provider-status refresh claim (single-flight). Null when idle.
  providerRefreshClaimedAt         DateTime?
  providerRefreshCompletedAt       DateTime?
  providerRefreshByAdminId         String?
  /// Sanitized lookup result: FOUND | NOT_FOUND | UNKNOWN | TIMEOUT | …
  providerRefreshResult            String?
  providerRefreshSafeCode          String?
  /// yes | no | unknown
  providerRefreshOrderExists       String?
  providerRefreshOfferMatch        String?
  providerRefreshInstallData       String?
  /// Short non-secret provider state token only.
  providerRefreshSafeState         String?
  failureCategory                  String?
  failureCode                      String?
  reconciliationState              String?
  emailDeliveryStatus              String?
  /// Durable once-only customer "order under review" email (RECONCILIATION_REQUIRED).
  reconRequiredEmailNotificationStatus String?
  reconRequiredEmailNotifiedAt     DateTime?
  /// Customer-confirmed alternate MAP install-email recipient. Null = account email.
  /// ConfirmedAt is customer attestation only — not email-ownership verification.
  alternateDeliveryEmail            String?
  alternateDeliveryEmailConfirmedAt DateTime?
  /// Set later when provider fulfillment is claimed.
  /// May be set even when alternateDeliveryEmail is null (account-email lock).
  alternateDeliveryEmailLockedAt    DateTime?
  createdAt                        DateTime                 @default(now())
  updatedAt                        DateTime                 @updatedAt
  completedAt                      DateTime?
  customer                         User                     @relation("WalletPurchaseCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  admin                            User?                    @relation("AssistedWalletPurchaseAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  order                            Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  debitTransaction                 WalletTransaction?       @relation("PurchaseDebitTx", fields: [debitTransactionId], references: [id], onDelete: SetNull)
  refundTransaction                WalletTransaction?       @relation("PurchaseRefundTx", fields: [refundTransactionId], references: [id], onDelete: SetNull)
  paymentAttempts                  EsimPurchasePaymentAttempt[]
  promoCode                        PromoCode?               @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoRedemption                  PromoCodeRedemption?
  rewardRedemption                 CustomerRewardRedemption?
  rewardTransactions               CustomerRewardTransaction[]

  @@index([customerUserId])
  @@index([promoCodeId])
  @@index([adminUserId])
  @@index([status])
  @@index([createdAt])
  @@index([customerUserId, createdAt])
  @@index([providerOrderId])
  @@index([providerResultKind])
  @@index([status, updatedAt])
  @@index([reconciliationResolvedAt])
  @@index([reconciliationLockedAt])
  @@index([reconciliationEscalatedAt])
  @@index([providerRefreshClaimedAt])
  @@index([providerRefreshResult])
  @@index([reconRequiredEmailNotificationStatus])
}

/// Durable PARTNER wallet-funded eSIM purchase attempt (provider write outside Prisma tx).
/// Completely separate from WalletEsimPurchase / Customer WalletAccount.
model PartnerEsimPurchase {
  id                               String                    @id @default(cuid())
  partnerId                        String
  offerId                          String
  destinationCode                  String?
  destinationName                  String?
  planName                         String?
  dataAllowance                    String?
  validity                         String?
  /// MAP retail catalog price snapshot (integer USD cents) — what Partner sees.
  retailPriceCents                 Int
  /// Partner discount snapshot in basis points at reserve/confirm time.
  discountBps                      Int
  /// PartnerProfile.discountVersion snapshot at reserve/confirm time.
  discountVersion                  Int
  /// Actual Partner wallet debit snapshot (integer USD cents). Refunds must reuse this.
  partnerChargeCents               Int
  /// Provider cost snapshot (integer USD cents) for floor checks / admin visibility.
  providerCostCents                Int
  currency                         String                    @default("USD")
  fundingSource                    OrderFundingSource        @default(PARTNER_BALANCE)
  status                           PartnerEsimPurchaseStatus @default(DRAFT)
  idempotencyKey                   String                    @unique
  debitTransactionId               String?                   @unique
  refundTransactionId              String?                   @unique
  orderId                          String?                   @unique
  /// Stored only when required for reconciliation; never shown as a public secret.
  providerOrderId                  String?
  /// Safe provider outcome snapshot: success | declined | uncertain | none
  providerResultKind               String?
  providerObservedAt               DateTime?
  /// Non-secret provider status token (e.g. http_500). Never raw payload.
  safeProviderStatusCode           String?
  reconciliationResolvedAt         DateTime?
  reconciliationResolvedByAdminId  String?
  reconciliationResolutionReason   String?
  reconciliationResolutionCode     String?
  reconciliationLockedAt           DateTime?
  reconciliationLockedByAdminId    String?
  reconciliationLockReason         String?
  reconciliationEscalatedAt        DateTime?
  reconciliationEscalatedByAdminId String?
  reconciliationEscalationReason   String?
  reconciliationEscalationPriority String?
  /// Durable provider-status refresh claim (single-flight). Null when idle.
  providerRefreshClaimedAt         DateTime?
  providerRefreshCompletedAt       DateTime?
  providerRefreshByAdminId         String?
  /// Sanitized lookup result: FOUND | NOT_FOUND | UNKNOWN | TIMEOUT | …
  providerRefreshResult            String?
  providerRefreshSafeCode          String?
  /// yes | no | unknown
  providerRefreshOrderExists       String?
  providerRefreshOfferMatch        String?
  providerRefreshInstallData       String?
  /// Short non-secret provider state token only.
  providerRefreshSafeState         String?
  failureCategory                  String?
  failureCode                      String?
  reconciliationState              String?
  emailDeliveryStatus              String?
  /// Durable once-only Partner "order under review" email (RECONCILIATION_REQUIRED).
  reconRequiredEmailNotificationStatus String?
  reconRequiredEmailNotifiedAt     DateTime?
  createdAt                        DateTime                  @default(now())
  updatedAt                        DateTime                  @updatedAt
  completedAt                      DateTime?
  partner                          PartnerProfile            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  order                            Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  debitTransaction                 PartnerWalletTransaction? @relation("PartnerPurchaseDebitTx", fields: [debitTransactionId], references: [id], onDelete: SetNull)
  refundTransaction                PartnerWalletTransaction? @relation("PartnerPurchaseRefundTx", fields: [refundTransactionId], references: [id], onDelete: SetNull)
  refundRequests                   PartnerRefundRequest[]

  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
  @@index([partnerId, createdAt])
  @@index([providerOrderId])
  @@index([providerResultKind])
  @@index([status, updatedAt])
  @@index([reconciliationResolvedAt])
  @@index([reconciliationLockedAt])
  @@index([reconciliationEscalatedAt])
  @@index([providerRefreshClaimedAt])
  @@index([providerRefreshResult])
  @@index([reconRequiredEmailNotificationStatus])
}

/// Opaque Partner eSIM share token. Store SHA-256 hash only; never persist or log the raw token.
/// No time-based expiry: an active token (revokedAt null) stays valid until revoke or regenerate.
model PartnerEsimShareToken {
  id         String         @id @default(cuid())
  partnerId  String
  orderId    String
  tokenHash  String         @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  revokedAt  DateTime?
  partner    PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([orderId])
  @@index([revokedAt])
}

/// Partner-initiated refund REQUEST only. Slice 1 never credits a wallet or calls the provider.
model PartnerRefundRequest {
  id                          String                      @id @default(cuid())
  partnerId                   String
  partnerEsimPurchaseId       String
  orderId                     String?
  reason                      PartnerRefundRequestReason
  /// Optional short Partner explanation (never a refund amount).
  partnerNote                 String?
  status                      RefundRequestStatus         @default(REQUESTED)
  /// Immutable Partner debit snapshot — the only refund basis.
  partnerChargeCents          Int
  /// Display snapshot only — never used as the refund amount.
  retailPriceCents            Int
  currency                    String                      @default("USD")
  /// Equals partnerEsimPurchaseId while open; null when terminal — at most one open request per purchase.
  openPurchaseKey             String?                     @unique
  adminDecisionNote           String?
  /// Future execution link only. Slice 1 never sets this.
  executedRefundTransactionId String?
  reviewedAt                  DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  partner                     PartnerProfile              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  purchase                    PartnerEsimPurchase         @relation(fields: [partnerEsimPurchaseId], references: [id], onDelete: Cascade)
  order                       Order?                      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([partnerEsimPurchaseId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([partnerId, createdAt])
  @@index([status, createdAt])
}

/// Gateway remainder payment attempt for a WalletEsimPurchase (not WalletTopup).
/// Multiple attempts per purchase are allowed; webhookEventId is globally unique when set.
model EsimPurchasePaymentAttempt {
  id                     String                           @id @default(cuid())
  purchaseId             String
  /// Authoritative gateway charge in USD cents (matches purchase.gatewayAmountCents at create time).
  gatewayAmountCents     Int
  currency               String                           @default("USD")
  /// Charge currency (e.g. PKR) only when a verified gateway quote exists.
  chargeCurrency         String?
  /// Charge amount in minor units only when a verified gateway quote exists.
  chargeAmountMinor      Int?
  fxRateSnapshot         String?
  gatewayProvider        PaymentGatewayProvider?
  /// Stored only when required for reconciliation; masked in customer UI.
  gatewayPaymentRef      String?
  status                 EsimPurchasePaymentAttemptStatus @default(DRAFT)
  checkoutIdempotencyKey String                           @unique
  /// Unique verified webhook/event id when available.
  webhookEventId         String?                          @unique
  failureCategory        String?
  failureCode            String?
  reconciliationState    String?
  expiresAt              DateTime?
  paymentConfirmedAt     DateTime?
  cancelledAt            DateTime?
  failedAt               DateTime?
  refundedAt             DateTime?
  /// Customer payment-failure email: null | sending | sent | failed | not_configured | skipped
  failureEmailNotificationStatus String?
  failureEmailNotifiedAt         DateTime?
  /// Snapshot at claim time: whether the email should mention wallet funds returned.
  failureEmailWalletReturned     Boolean?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  purchase               WalletEsimPurchase               @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([status])
  @@index([createdAt])
  @@index([purchaseId, createdAt])
  @@index([gatewayProvider])
  @@index([failureEmailNotificationStatus])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

/// Customer USD wallet account. One per user. Balance is integer cents only.
model WalletAccount {
  id           String              @id @default(cuid())
  userId       String              @unique
  currency     WalletCurrency      @default(USD)
  balanceCents Int                 @default(0)
  version      Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([createdAt])
}

/// Append-only wallet ledger entry.
model WalletTransaction {
  id                               String                  @id @default(cuid())
  walletId                         String
  type                             WalletTransactionType
  direction                        WalletDirection
  status                           WalletTransactionStatus
  amountCents                      Int
  /// Balance before this ledger movement (null for legacy rows).
  balanceBeforeCents               Int?
  balanceAfterCents                Int?
  idempotencyKey                   String?                 @unique
  referenceType                    String?
  referenceId                      String?
  /// Wallet balance-change email: null | sending | sent | failed | not_configured | skipped
  emailNotificationStatus          String?
  emailNotifiedAt                  DateTime?
  /// Case-management only — never stores email body or SMTP secrets.
  reconciliationResolvedAt         DateTime?
  reconciliationResolvedByAdminId  String?
  reconciliationResolutionReason   String?
  reconciliationResolutionCode     String?
  reconciliationLockedAt           DateTime?
  reconciliationLockedByAdminId    String?
  reconciliationLockReason         String?
  reconciliationEscalatedAt        DateTime?
  reconciliationEscalatedByAdminId String?
  reconciliationEscalationReason   String?
  reconciliationEscalationPriority String?
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt
  wallet                           WalletAccount           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  purchaseAsDebit                  WalletEsimPurchase?     @relation("PurchaseDebitTx")
  purchaseAsRefund                 WalletEsimPurchase?     @relation("PurchaseRefundTx")
  topupAsCredit                    WalletTopup?            @relation("TopupCreditTx")

  @@index([walletId])
  @@index([createdAt])
  @@index([type])
  @@index([status])
  @@index([walletId, createdAt])
  @@index([emailNotificationStatus])
  @@index([reconciliationResolvedAt])
  @@index([reconciliationLockedAt])
  @@index([reconciliationEscalatedAt])
}

/// Gateway-independent CUSTOMER wallet top-up attempt.
/// Wallet credit occurs only after a verified server-to-server payment event.
model WalletTopup {
  id                               String                  @id @default(cuid())
  customerUserId                   String
  /// Desired USD wallet credit in integer cents.
  creditAmountCents                Int
  /// Charge currency (e.g. PKR) only when a verified gateway quote exists.
  chargeCurrency                   String?
  /// Charge amount in minor units only when a verified gateway quote exists.
  chargeAmountMinor                Int?
  /// Opaque FX snapshot from a verified rate/gateway source only — never invented.
  fxRateSnapshot                   String?
  gatewayProvider                  PaymentGatewayProvider?
  /// Stored only when required for reconciliation; masked in customer UI.
  gatewayPaymentRef                String?
  status                           WalletTopupStatus       @default(DRAFT)
  checkoutIdempotencyKey           String                  @unique
  /// Unique verified webhook/event id when available.
  webhookEventId                   String?                 @unique
  walletTransactionId              String?                 @unique
  failureCategory                  String?
  failureCode                      String?
  /// Case-management only — never stores gateway secrets or raw payloads.
  reconciliationResolvedAt         DateTime?
  reconciliationResolvedByAdminId  String?
  reconciliationResolutionReason   String?
  reconciliationResolutionCode     String?
  reconciliationLockedAt           DateTime?
  reconciliationLockedByAdminId    String?
  reconciliationLockReason         String?
  reconciliationEscalatedAt        DateTime?
  reconciliationEscalatedByAdminId String?
  reconciliationEscalationReason   String?
  reconciliationEscalationPriority String?
  expiresAt                        DateTime?
  paymentConfirmedAt               DateTime?
  walletCreditedAt                 DateTime?
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt
  customer                         User                    @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  walletTransaction                WalletTransaction?      @relation("TopupCreditTx", fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@index([customerUserId])
  @@index([status])
  @@index([createdAt])
  @@index([customerUserId, createdAt])
  @@index([gatewayProvider])
  @@index([reconciliationResolvedAt])
  @@index([reconciliationLockedAt])
  @@index([reconciliationEscalatedAt])
}

/// Durable ADMIN-only runtime pause switches for new transaction initiation.
/// Pausing never mutates wallets, purchases, assignments, orders, refunds, email, or ICCID.
/// Default paused=false preserves current open behavior when rows are seeded.
model OperationalControl {
  id               String                @id @default(cuid())
  key              OperationalControlKey @unique
  /// When true, new initiation for this control scope is paused.
  paused           Boolean               @default(false)
  /// Optimistic concurrency / CAS token.
  version          Int                   @default(0)
  /// Last safe admin reason (truncated in UI/audits). Never secrets.
  reason           String?
  updatedByAdminId String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([paused])
  @@index([updatedAt])
}

/// Singleton runtime config for the public WhatsApp support button.
/// Admin-editable without redeploy. Never stores secrets or arbitrary JSON.
model WhatsAppSupportConfig {
  /// Fixed singleton id — always "default".
  id               String   @id
  enabled          Boolean  @default(false)
  /// Digits-only international number for wa.me (no +). Null when unset.
  phoneE164        String?
  /// Plain-text default chat message. Null/empty allowed when disabled.
  defaultMessage   String?
  version          Int      @default(1)
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Lifecycle state per deterministic Part B1 alert ID (activation cycles).
/// Display statuses like not-eligible / cooldown are derived, not stored.
model AlertNotificationState {
  id                 String    @id @default(cuid())
  alertId            String    @unique
  alertCode          String
  severity           String
  category           String
  /// Sanitized source type token (e.g. wallet_purchase, config).
  sourceType         String?
  /// Masked/safe internal reference only — never full customer email or secrets.
  sourceRecordRef    String?
  isActive           Boolean   @default(true)
  activationSequence Int       @default(1)
  firstSeenAt        DateTime
  lastSeenAt         DateTime
  activatedAt        DateTime
  resolvedAt         DateTime?
  lastNotifiedAt     DateTime?
  nextReminderAt     DateTime?
  recoveryNotifiedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  deliveries AlertNotificationDelivery[]

  @@index([isActive])
  @@index([lastSeenAt])
  @@index([alertCode])
  @@index([activationSequence])
}

/// Durable outbox row per deterministic delivery event (initial/reminder/recovery).
/// SMTP is not perfect exactly-once if crash occurs after accept and before SENT update;
/// unique eventKey + CAS claim minimize normal concurrent/restart duplication.
model AlertNotificationDelivery {
  id                 String                          @id @default(cuid())
  eventKey           String                          @unique
  alertId            String
  activationSequence Int
  eventType          AlertNotificationEventType
  status             AlertNotificationDeliveryStatus @default(PENDING)
  attemptCount       Int                             @default(0)
  nextAttemptAt      DateTime?
  claimToken         String?
  claimedAt          DateTime?
  claimExpiresAt     DateTime?
  lastAttemptAt      DateTime?
  sentAt             DateTime?
  /// Allowlisted opaque code only — never raw SMTP text, recipients, or bodies.
  lastErrorCode      String?
  /// Deterministic sanitized Message-ID derived from eventKey when sent.
  messageId          String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt

  state AlertNotificationState @relation(fields: [alertId], references: [alertId], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([alertId, activationSequence])
  @@index([claimedAt])
  @@index([eventType, status])
}

/// Singleton CAS lock so concurrent alert-notification runners do not overlap.
model AlertNotificationRunnerLock {
  id             String    @id @default("default")
  claimToken     String?
  claimedAt      DateTime?
  claimExpiresAt DateTime?
  updatedAt      DateTime  @updatedAt
}

/// Customer-initiated refund request for admin review.
/// Approve/reject only — never credits wallet or calls gateway/provider refund APIs.
model RefundRequest {
  id                   String              @id @default(cuid())
  orderId              String
  customerUserId       String
  /// Linked wallet purchase when present (payment composition source).
  purchaseId           String?
  reason               RefundRequestReason
  /// Optional short customer explanation (never a refund amount).
  customerNote         String?
  status               RefundRequestStatus @default(REQUESTED)
  /// Authoritative refundable USD cents from server records at request time.
  refundAmountCents    Int
  currency             String              @default("USD")
  /// Payment composition snapshot for later execution (no money movement here).
  walletAppliedCents   Int                 @default(0)
  gatewayAmountCents   Int                 @default(0)
  fundingSource        OrderFundingSource?
  /// Equals orderId while open; null when terminal — at most one open request per order.
  openOrderKey         String?             @unique
  adminDecisionNote    String?
  reviewedByAdminId    String?
  reviewedAt           DateTime?
  decidedByAdminId     String?
  decidedAt            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer             User                @relation("RefundRequestCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  reviewedByAdmin      User?               @relation("RefundRequestReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  decidedByAdmin       User?               @relation("RefundRequestDecidedBy", fields: [decidedByAdminId], references: [id], onDelete: SetNull)

  @@index([customerUserId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([customerUserId, createdAt])
  @@index([status, createdAt])
}

/// Admin-managed customer checkout promo. Code is stored normalized (uppercase).
model PromoCode {
  id                     String              @id @default(cuid())
  /// Unique normalized code, e.g. SUMMER20
  code                   String              @unique
  description            String?
  discountType           PromoDiscountType
  /// PERCENT: 1–100. FIXED_USD: integer USD cents > 0.
  discountValue          Int
  isActive               Boolean             @default(true)
  startsAt               DateTime?
  endsAt                 DateTime?
  totalUsageLimit        Int?
  perCustomerUsageLimit  Int?
  minimumOrderCents      Int?
  firstOrderOnly         Boolean             @default(false)
  usageCount             Int                 @default(0)
  createdByAdminId       String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  createdByAdmin         User?               @relation("PromoCodeCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  destinations           PromoCodeDestination[]
  offers                 PromoCodeOffer[]
  redemptions            PromoCodeRedemption[]
  purchases              WalletEsimPurchase[]

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
  @@index([createdAt])
}

model PromoCodeDestination {
  id               String    @id @default(cuid())
  promoCodeId      String
  /// Authoritative destination code (ISO-2, region-*, or global).
  destinationCode  String
  promoCode        PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, destinationCode])
  @@index([destinationCode])
}

model PromoCodeOffer {
  id          String    @id @default(cuid())
  promoCodeId String
  offerId     String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, offerId])
  @@index([offerId])
}

/// Durable promo usage. Created only at funded/reserved stage — never on apply-preview.
model PromoCodeRedemption {
  id                   String                 @id @default(cuid())
  promoCodeId          String
  customerUserId       String
  walletEsimPurchaseId String                 @unique
  orderId              String?
  status               PromoRedemptionStatus  @default(HELD)
  promoCodeNormalized  String
  discountType         PromoDiscountType
  discountValue        Int
  originalPriceCents   Int
  discountCents        Int
  finalPriceCents      Int
  createdAt            DateTime               @default(now())
  completedAt          DateTime?
  promoCode            PromoCode              @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  customer             User                   @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  purchase             WalletEsimPurchase     @relation(fields: [walletEsimPurchaseId], references: [id], onDelete: Cascade)
  order                Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([promoCodeId])
  @@index([customerUserId])
  @@index([status])
  @@index([promoCodeId, customerUserId, status])
  @@index([createdAt])
}

/// Customer-only rewards ledger. Partner users never receive an account.
model CustomerRewardAccount {
  id                     String                      @id @default(cuid())
  customerUserId         String                      @unique
  pointsBalance          Int                         @default(0)
  /// Gross points ever earned from completed purchases. Not reduced on earn reversal.
  lifetimeEarnedPoints   Int                         @default(0)
  /// Gross points ever completed-redeemed. Not reduced on refund restore. Hold-release does not increment this.
  lifetimeRedeemedPoints Int                         @default(0)
  /// CAS version for concurrent earn retries.
  version                Int                         @default(0)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  customer               User                        @relation("CustomerRewardAccount", fields: [customerUserId], references: [id], onDelete: Cascade)
  transactions           CustomerRewardTransaction[]
  redemptions            CustomerRewardRedemption[]

  @@index([createdAt])
}

/// Durable customer reward reservation (promo-like HELD → COMPLETED / RELEASED).
model CustomerRewardRedemption {
  id                   String                          @id @default(cuid())
  customerUserId       String
  rewardAccountId      String
  walletEsimPurchaseId String                          @unique
  status               CustomerRewardRedemptionStatus  @default(HELD)
  /// Points reserved from pointsBalance. 1 point = 1 USD cent.
  pointsHeld           Int
  /// Package cents after promo at hold time (earning basis is this amount, not cash payable).
  afterPromoCents      Int
  completedAt          DateTime?
  orderId              String?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  customer             User                            @relation("CustomerRewardRedemption", fields: [customerUserId], references: [id], onDelete: Cascade)
  account              CustomerRewardAccount           @relation(fields: [rewardAccountId], references: [id], onDelete: Cascade)
  purchase             WalletEsimPurchase              @relation(fields: [walletEsimPurchaseId], references: [id], onDelete: Cascade)

  @@index([customerUserId, createdAt])
  @@index([status])
  @@index([createdAt])
}

/// Append-only customer rewards ledger.
/// PURCHASE_EARN / PURCHASE_EARN_REVERSAL / REDEMPTION are one-per-purchase via partial unique indexes.
/// REDEMPTION_RESTORE may exist twice (pre-funding hold release vs post-refund restore), distinguished by idempotencyKey.
/// lifetimeRedeemedPoints / lifetimeEarnedPoints are gross completed totals and are not reduced on refund restore/reversal.
model CustomerRewardTransaction {
  id                 String                         @id @default(cuid())
  rewardAccountId    String
  customerUserId     String
  type               CustomerRewardTransactionType
  pointsDelta        Int
  balanceAfter       Int
  /// Snapshotted eligible customer package cents (after promo). Reconstructs history.
  eligibleSpendCents Int?
  purchaseId         String?
  orderId            String?
  refundRequestId    String?
  idempotencyKey     String                         @unique
  createdAt          DateTime                       @default(now())
  account            CustomerRewardAccount          @relation(fields: [rewardAccountId], references: [id], onDelete: Cascade)
  customer           User                           @relation("CustomerRewardTransaction", fields: [customerUserId], references: [id], onDelete: Cascade)
  purchase           WalletEsimPurchase?            @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  order              Order?                         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerUserId, createdAt])
  @@index([rewardAccountId, createdAt])
  @@index([type])
  @@index([createdAt])
}
